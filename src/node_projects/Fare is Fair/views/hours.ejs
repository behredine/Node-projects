<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/public/stylesheets/style.css" />
    <title>Operating Hours | Fare is Fair</title>
  </head>
  <body>
    <!-- Top Navigation -->
    <nav class="navbar">
      <div class="nav-container">
        <a href="/" class="nav-brand">🍽️ Fare is Fair</a>
        <div class="nav-links">
          <a href="/" class="nav-link">Home</a>
          <a href="/menu" class="nav-link">Menu</a>
          <a href="/hours" class="nav-link active">Hours</a>
        </div>
      </div>
    </nav>

    <!-- Main Container -->
    <main class="container hours-page">
      <div class="page-header">
        <h1>Our Operating Hours</h1>
        <p class="subtitle">Join us for lunch or dinner. We take reservations and walk-ins throughout the week.</p>
      </div>

      <div class="hours-container">
        <% for (day of days){%>
          <%const hourObjs = operatingHours[day] || operatingHours['defaultHours']; %>
          <section style="display: inline-flex; flex-direction: column; padding: 5px;">
            <h2><%= day.toUpperCase() %></h2>
            <div>
              <%if(hourObjs.open){%>
                <p><span>Opening:</span> <strong><%= hourObjs.open %>:00</strong></p>
                <p><span>Closing:</span> <strong><%= hourObjs.closed %>:00</strong></p>
              <% } else { %>
                <p>Closed Today</p>
              <%}%>
            </div>
          </section>
        <%}%>
      </div>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <p>&copy; 2026 Fare is Fair Restaurant. Powered by Node.js &amp; Fastify.</p>
    </footer>
  </body>
</html>
